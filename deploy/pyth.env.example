# Pyth Hermes API Key
#
# Pyth Core 于 2026-08-26 16:00 UTC 升级后，Hermes 强制要求认证，
# 匿名请求一律返回 401。到 https://pythdata.app/signup 注册 Pyth Terminal 获取。
#
# 认证方式为 Authorization: Bearer <key>；x-api-key 头与 query 参数均无效（401/400）。
#
# 部署：放到 /etc/goldmon/pyth.env，chmod 600，由 systemd 的 EnvironmentFile 加载。
PYTH_API_KEY=your_pyth_api_key_here
